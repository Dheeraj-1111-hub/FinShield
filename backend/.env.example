# FINSHIELD Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.

# Environment Classification
ENVIRONMENT=local

# Database Connection (SQLite async default, or PostgreSQL asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./finshield.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finshield

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Cryptographic & Security Secrets (Generate 32+ character random strings in production)
SESSION_SECRET=change_me_to_a_secure_random_session_secret_32_chars
JWT_SECRET=change_me_to_a_secure_random_jwt_secret_32_chars
ENCRYPTION_KEY=change_me_to_a_secure_random_encryption_key_32_chars
WEBHOOK_SIGNING_SECRET=change_me_to_a_secure_random_webhook_secret_32_chars

# External LLM Provider Configurations (Optional / Modular)
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
